    {
      "id": "t0093",
      "type": "text",
      "x": 66,
      "y": 1850.875,
      "width": 408,
      "height": 96.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
