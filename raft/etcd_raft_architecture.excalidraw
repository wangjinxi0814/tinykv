    },
    {
      "id": "t0100",
      "type": "text",
      "x": 566,
      "y": 1792.125,
      "width": 328,
      "height": 123.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
